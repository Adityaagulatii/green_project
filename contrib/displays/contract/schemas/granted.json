{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aygp-dr/17x9-Tetris/contrib/displays/contract/schemas/granted.json",
  "title": "granted",
  "description": "wal.sh/tools/display v0.2.1, Wire protocol: the granted message.",
  "type": "object",
  "required": [
    "op",
    "lease",
    "w",
    "h",
    "fps",
    "format",
    "palette",
    "expires"
  ],
  "properties": {
    "op": {
      "const": "granted"
    },
    "lease": {
      "type": "string",
      "minLength": 1
    },
    "w": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "h": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "format": {
      "enum": [
        "pal16",
        "hex",
        "rgb24"
      ],
      "description": "the format the source reserved"
    },
    "palette": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "description": "16 colours, index 0 first; a short named palette is announced through the level rule (palette16)"
    },
    "expires": {
      "type": "integer",
      "minimum": 0,
      "description": "unix seconds"
    }
  },
  "additionalProperties": true
}
