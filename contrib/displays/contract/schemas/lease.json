    "op": {
      "const": "lease"
    },
    "display": {
      "type": "string",
      "minLength": 1
    },
    "holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
