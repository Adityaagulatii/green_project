{:min-bb-version "1.12.0"
 ;; No :deps here on purpose: everything the code needs at run time is built
 ;; into babashka (spec, test.check, cheshire, http-kit, babashka.cli), so
 ;; the fast loop never starts a JVM (no deps.clj classpath resolution).
 ;; deps.edn stays the canonical manifest for the JVM (STANDARD section 3).
 :paths ["src" "resources"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.java.io :as io])
  :init (do (def src-dirs (filterv fs/directory? ["src" "test" "dev"]))
            ;; bb.edn is EDN: no #() or #"" literals
            (defn test-nses []
              (->> (fs/glob "test" "**.clj")
                   (keep (fn [p]
                           (with-open [r (java.io.PushbackReader. (io/reader (str p)))]
                             (let [form (read r)]
                               (when (and (seq? form) (= 'ns (first form)))
                                 (second form))))))
                   (filter (fn [sym] (re-find (re-pattern "-test$") (str sym))))
                   sort)))

  test     {:doc "Fast loop: every *-test namespace under babashka, no JVM (bb test [ns ...])"
            :extra-paths ["test"]
            :task (let [nses (if (seq *command-line-args*)
                               (map symbol *command-line-args*)
                               (test-nses))]
                    (when (empty? nses)
                      (throw (ex-info "no *-test namespaces under test/" {})))
                    (apply require nses)
                    (let [{:keys [fail error]} (apply clojure.test/run-tests nses)]
                      (when (pos? (+ fail error))
                        (throw (ex-info "bb tests failed" {:fail fail :error error})))))}

  test:jvm {:doc "The same suite on the JVM: clojure -M:test (in the jail: under the heavy lock)"
            :task (apply shell "clojure -M:test" *command-line-args*)}

  lint     {:doc "Lint with clj-kondo (fails on errors, reports warnings)"
            :task (apply shell "clojure -M:lint --fail-level error --lint" src-dirs)}

  fmt      {:doc "Check formatting with cljfmt"
            :task (apply shell "clojure -M:fmt check" src-dirs)}

  fmt:fix  {:doc "Fix formatting with cljfmt"
            :task (apply shell "clojure -M:fmt fix" src-dirs)}

  check    {:doc "lint + fmt + test + test:jvm (what CI runs)"
            :depends [lint fmt test test:jvm]}

  caps:edn {:doc "Regenerate resources/tetris/displays/capabilities.edn from the pinned capabilities.json (bb caps:edn [path/to/new/capabilities.json])"
            :requires ([cheshire.core :as json]
                       [clojure.pprint :as pp]
                       [clojure.walk :as walk])
            :task (let [json-path "resources/tetris/displays/capabilities.json"
                        edn-path "resources/tetris/displays/capabilities.edn"
                        ;; the top-level keys the EDN carries: tetris.displays.caps/edn-keys
                        ks [:spec :default :formats :max :reservation :palette :palettes :displays]
                        _ (when-let [src (first *command-line-args*)]
                            (fs/copy src json-path {:replace-existing true})
                            (println "copied" src "->" json-path))
                        m (select-keys (json/parse-string (slurp json-path) true) ks)
                        sorted (walk/postwalk (fn [x] (if (map? x) (into (sorted-map) x) x)) m)]
                    (spit edn-path
                          (str ";; GENERATED by `bb caps:edn` from capabilities.json (wal.sh/tools/display "
                               (:spec m) "); do not edit.\n"
                               (binding [pp/*print-right-margin* 100]
                                 (with-out-str (pp/pprint sorted)))))
                    (println "wrote" edn-path "-" (count (:displays m)) "displays,"
                             (count (:palettes m)) "palettes"))}

  relay    {:doc "The v0.2.1 relay on loopback: bb relay [--port 8765] [--default green-building] [--log events.edn]"
            :task (apply (requiring-resolve 'tetris.displays.relay/-main) *command-line-args*)}

  fixtures {:doc "Cross-check codec, core and lease against the displays-contract fixtures: bb fixtures [dir] (default $DISPLAYS_FIXTURES, else ../contract/fixtures)"
            :extra-paths ["test"]
            :task (apply (requiring-resolve 'tetris.displays.fixtures-test/-main) *command-line-args*)}}}
